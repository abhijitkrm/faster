# Copy to .env and edit. Every setting is optional except RPC_URL for a real chain.

# Node JSON-RPC every service reads from. Unset = the demo chain (profile demo).
RPC_URL=

# Prebuilt images instead of local builds (a release tag of this repo)
IMAGE_REGISTRY=faster
IMAGE_TAG=local

# Host ports
EXPLORER_PORT=4000
SYNC_PORT=3100
RPC_PORT=8545
INDEX_PORT=8080

# explorer
EXPLORER_START_BLOCK=0
CONFIRMATIONS=0
TRACE_CALLS=false
RATE_LIMIT_RPS=100
CORS_ORIGINS=*
# with the clob profile: http://clickhouse:8123
EXPLORER_CLICKHOUSE_URL=

# data (faster-sync, faster-rpc)
SYNC_START_BLOCK=0
SYNC_TRACES=false
# requests per second to RPC_URL; set ~6 for free public endpoints
SYNC_RPC_RPS=0
SYNC_FINALITY_DEPTH=64
SYNC_API_KEYS=
RPC_API_KEYS=

# index (faster-index): project directory inside faster-index/
INDEX_PROJECT=examples/erc20
INDEX_START_BLOCK=0
POSTGRES_PASSWORD=findex

# clob
CLICKHOUSE_USER=clob
CLICKHOUSE_PASSWORD=change_me
CLOB_NODE_RPC=http://host.docker.internal:8545

# demo chain: head at start, ms per new block, txs per block
DEMO_HEAD=5000
DEMO_BLOCK_MS=1000
DEMO_TXS=50

LOG_LEVEL=info
RUST_LOG=info
