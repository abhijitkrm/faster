# Faster explorer — copy to .env and edit.

# Node JSON-RPC endpoint (required)
RPC_URL=http://your-node:8545

# Public port of the UI + API (nginx)
HTTP_PORT=4000

# Indexing
START_BLOCK=0
CONFIRMATIONS=0
REORG_DEPTH=256
FETCH_BATCH=10
FETCH_CONCURRENCY=16
CACHE_MB=512
# Internal transactions: needs debug_traceBlockByNumber (archive node for history)
TRACE_CALLS=false

# API protection
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
CORS_ORIGINS=*

# UI -> API base URL; empty = same origin (recommended)
FASTER_API_URL=

# CLOB archive (optional): ClickHouse credentials and the evm-node to archive
CLICKHOUSE_USER=clob
CLICKHOUSE_PASSWORD=change_me
NODE_RPC=http://host.docker.internal:8545

LOG_LEVEL=info
